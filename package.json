{
  "name": "steeny-client",
  "version": "2.0.0",
  "description": "Безопасный Electron-клиент для музыкального сервиса STEENY",
  "main": "src/main.js",
  "author": {
    "name": "Ivan0n",
    "email": "Ivan0n@users.noreply.github.com"
  },
  "desktopName": "steeny.desktop",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/rpc.js",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fun.steeny.desktop",
    "productName": "STEENY",
    "executableName": "steeny",
    "artifactName": "STEENY-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "STEENY-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "STEENY-${version}-windows-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "AudioVideo;Audio;Player",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
